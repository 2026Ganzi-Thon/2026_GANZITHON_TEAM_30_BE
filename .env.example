# 이 파일을 .env로 복사해서 값을 채우세요. .env는 깃에 올라가지 않습니다.
ENV=dev
DATABASE_URL=sqlite:///./ganzithon.db
# PostgreSQL 예: DATABASE_URL=postgresql://user:password@localhost:5432/ondo  (psycopg 드라이버로 자동 변환)
# SECRET_KEY=   # 비워 두면 개발용 값을 씀. ENV=production에서는 반드시 설정 (없으면 서버가 시작되지 않음)
# 비우면 로컬 개발 주소(localhost:5500·5173·3000)만 허용. 배포 때는 FE 주소를 쉼표로 구분해 적는다
CORS_ORIGINS=
TRUST_PROXY=0
RATE_LIMIT_ENABLED=1
REPORT_HIDE_THRESHOLD=3
REPORT_FORCE_HIDE_THRESHOLD=6
REPORT_TRUSTED_ACCOUNT_HOURS=24
ADMIN_EMAILS=
AI_FOLLOWUP_MAX=10
AI_DAILY_REPLY_LIMIT=30
INVITE_MAX_PER_POST=3
INVITE_DAILY_PER_USER=3
UPSTAGE_API_KEY=

# 이메일 인증코드: demo = 메일 없이 응답에 코드 표시 / smtp = 실제 메일 발송
EMAIL_MODE=demo
# Gmail 예시 (2단계 인증을 켠 뒤 Google 계정 > 보안 > 앱 비밀번호에서 16자리 발급)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# 보내는 사람 표시 (비우면 SMTP_USER). 예: ON-DO <ondo.team30@gmail.com>
SMTP_FROM=

# AI (B): auto면 UPSTAGE_API_KEY → GEMINI_API_KEY 순으로 쓰고, 둘 다 없으면 local(규칙 검사·기본 문장·로컬 임베딩)
AI_PROVIDER=auto
GEMINI_API_KEY=
# SEARCH_MIN_SIMILARITY=0.30   # 유사 검색 "결과 없음" 기준값 (실제 키로 시연 데이터 보고 조정)
